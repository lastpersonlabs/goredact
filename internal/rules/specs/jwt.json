          "{\"stdout\":\"introspecting eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQ4MjEiLCJzY29wZSI6InRyYW5zY3JpcHRzOnJlYWQiLCJpYXQiOjE3NTUxNzI4MDB9.q4TnV7bXk2LwZ9pR0sYhF6dJ1aG5uEiO8cM3rTvQ6wN\\n\"}"
        ],
        "nomatch": [
          "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9",
