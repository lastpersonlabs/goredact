{
  "rules": [
    {
      "id": "aws-access-key-id",
      "name": "AWS access key ID",
      "triggers": [
        {
          "literal": "AKIA",
          "caseFold": false
        },
        {
          "literal": "ASIA",
          "caseFold": false
        },
        {
          "literal": "ABIA",
          "caseFold": false
        },
        {
          "literal": "ACCA",
          "caseFold": false
        }
      ],
      "validator": "AWSAccessKeyID",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 1,
      "maxLookahead": 18,
      "provenance": {
        "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_identifiers.html#identifiers-unique-ids",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "AWS_ACCESS_KEY_ID=AKIAUJZDEGXDNCF32EPF",
          "{\"accessKeyId\": \"ASIA3DHODZDOCIS2JHTL\", \"region\": \"us-east-1\"}",
          "aws configure set aws_access_key_id ACCAGMXGEDN73U55XTPL"
        ],
        "nomatch": [
          "AWS_ACCESS_KEY_ID=AKIASHORT",
          "AWS_ACCESS_KEY_ID=AKIAujzdegxdncf32epf",
          "AWS_ACCESS_KEY_ID=XAKIAUJZDEGXDNCF32EPF",
          "AWS_ACCESS_KEY_ID=AKIAUJZDEGXDNCF32EPF9",
          "# example from the AWS docs: AKIAIOSFODNN7EXAMPLE"
        ]
      }
    },
    {
      "id": "aws-secret-access-key",
      "name": "AWS secret access key",
      "triggers": [
        {
          "literal": "aws_secret_access_key",
          "caseFold": true
        }
      ],
      "validator": "AWSSecretAccessKey",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 0,
      "maxLookahead": 80,
      "provenance": {
        "source": "https://docs.aws.amazon.com/general/latest/gr/aws-access-keys-best-practices.html",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "AWS_SECRET_ACCESS_KEY=fKm/r5kJP1VrT+1FJors/6ILi8IHn5kxsC7tVO/H",
          "aws_secret_access_key: bkQfyy/KV5zjR3j1twdTKWTddB+XhkAS1voQG6yy",
          "aws_secret_access_key = 'fKm/r5kJP1VrT+1FJors/6ILi8IHn5kxsC7tVO/H'",
          "{\"aws_secret_access_key\": \"fKm/r5kJP1VrT+1FJors/6ILi8IHn5kxsC7tVO/H\"}"
        ],
        "nomatch": [
          "AWS_SECRET_ACCESS_KEY=tooshort",
          "AWS_SECRET_ACCESS_KEY aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "AWS_SECRET_ACCESS_KEY=fKm/r5kJP1VrT+1FJors/6ILi8IHn5kxsC7tVO/!",
          "aws_secret_access_key=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
        ]
      }
    },
    {
      "id": "gcp-api-key",
      "name": "GCP API key",
      "triggers": [
        {
          "literal": "AIza",
          "caseFold": false
        }
      ],
      "validator": "GCPAPIKey",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 1,
      "maxLookahead": 37,
      "provenance": {
        "source": "https://cloud.google.com/docs/authentication/api-keys",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "GOOGLE_API_KEY=AIzazyN9zHYIa4UOrGNATMuDJawTgsu8PO_799n",
          "{\"apiKey\": \"AIzaKSNrh9UCauSDmLhuVtcqcYezdZ-tDDj8hYs\", \"authDomain\": \"example.firebaseapp.com\"}"
        ],
        "nomatch": [
          "GOOGLE_API_KEY=AIzatooshort",
          "GOOGLE_API_KEY=AIza!zyN9zHYIa4UOrGNATMuDJawTgsu8PO_799n",
          "GOOGLE_API_KEY=xAIzazyN9zHYIa4UOrGNATMuDJawTgsu8PO_799n",
          "GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        ]
      }
    },
    {
      "id": "azure-storage-account-key",
      "name": "Azure storage account key",
      "triggers": [
        {
          "literal": "AccountKey=",
          "caseFold": true
        }
      ],
      "validator": "AzureStorageAccountKey",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 0,
      "maxLookahead": 100,
      "provenance": {
        "source": "https://learn.microsoft.com/en-us/azure/storage/common/storage-account-keys-manage",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "DefaultEndpointsProtocol=https;AccountName=contosostorage;AccountKey=5suKcNd8Zra9A9sKPxZ9W3qLy7zKUVQDT7S8sTQCBNR3YbDgbleph1QHt61QTC4XATWS8PHp9NHfYjFM5DI4pZ==;EndpointSuffix=core.windows.net",
          "AZURE_STORAGE_ACCOUNT_KEY=\"AccountKey=j59fhZ5R1Py4oJe2JbmPTuSgR7cMy+UcU3zr1ZtoLuCr64CxqlIOdNKhiFXiQ2hzT/pLjHX2JiCLhKcIhP6Br1==\""
        ],
        "nomatch": [
          "AccountKey=tooshort==",
          "AccountKey=5suKcNd8Zra9A9sKPxZ9W3qLy7zKUVQDT7S8sTQCBNR3YbDgbleph1QHt61QTC4XATWS8PHp9NHfYjFM5DI4pZ",
          "AccountKey=5suKcNd8Zra9A9sKPxZ9W3qLy7zKUVQDT7S8sTQCBNR3YbDgbleph1QHt61QTC4XATWS8PHp9NHfYjFM5DI4pZ!!",
          "AccountKey=5suKcNd8Zra9A9sKPxZ9W3qLy7zKUVQDT7S8sTQCBNR3YbDgbleph1QHt61QTC4XATWS8PHp9NHfYjFM5DI4pZ===extra"
        ]
      }
    },
    {
      "id": "azure-servicebus-sas-key",
      "name": "Azure Service Bus / Event Hubs shared access key",
      "triggers": [
        {
          "literal": "SharedAccessKey=",
          "caseFold": true
        }
      ],
      "validator": "AzureServiceBusSASKey",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 0,
      "maxLookahead": 60,
      "provenance": {
        "source": "https://learn.microsoft.com/en-us/azure/service-bus-messaging/service-bus-sas; https://learn.microsoft.com/en-us/azure/event-hubs/event-hubs-get-connection-string",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "Endpoint=sb://contoso-ns.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=dLIcySo/hlQZbpcUeroBfki2yLt1qc6PCYFQP79YcXe=",
          "EVENTHUB_CONNECTION=\"Endpoint=sb://contoso-eh.servicebus.windows.net/;SharedAccessKeyName=send;SharedAccessKey=DLgtjFOrVEiHuAPOAJFIuaiduxuRQ4I/QWODAAReCfD=;EntityPath=orders\""
        ],
        "nomatch": [
          "SharedAccessKey=LkkRnssrJa6yw4IUk6yEu4d+yIVGY+=",
          "SharedAccessKey=dLIcySo/hlQZbpcUeroBfki2yLt1qc6PCYFQP79YcXe",
          "SharedAccessKey=dLIcySo/hlQZbpcUeroBfki2yLt1qc6PCYFQP79YcXe=="
        ]
      }
    },
    {
      "id": "azure-app-configuration-secret",
      "name": "Azure App Configuration secret",
      "triggers": [
        {
          "literal": "Secret=",
          "caseFold": true
        }
      ],
      "validator": "AzureAppConfigurationSecret",
      "minProfile": "balanced",
      "confidence": "medium",
      "maxLookbehind": 0,
      "maxLookahead": 60,
      "provenance": {
        "source": "https://learn.microsoft.com/en-us/azure/azure-app-configuration/enable-dynamic-configuration-dotnet-core-push-refresh; https://learn.microsoft.com/en-us/azure/service-connector/how-to-integrate-app-configuration",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "AZURE_APPCONFIG_CONNECTION_STRING=Endpoint=https://contoso.azconfig.io;Id=abcd-e6-s0:tl6ABcdefGHi7kLMno;Secret=mmxAIeZe895Wtq/pyHd+4RKKU6RfN71uJyIJ1Vzm53g=",
          "{\"connectionString\":\"Endpoint=https://contoso.azconfig.io;Id=09pv-l0-s0:opFCQMC6zZ9485xJgN;Secret=iaTWpoAYKKGb273wx7ErgccAESuzBn3NcoaAoP37zKP=\"}"
        ],
        "nomatch": [
          "Secret=jCIM7QEMhof8hn9tGqXB=",
          "Secret=mmxAIeZe895Wtq/pyHd+4RKKU6RfN71uJyIJ1Vzm53g",
          "client_secret=mmxAIeZe895Wtq/pyHd+4RKKU6RfN71uJyIJ1Vzm53gXX"
        ]
      }
    },
    {
      "id": "vault-service-token",
      "name": "HashiCorp Vault service token",
      "triggers": [
        {
          "literal": "hvs.",
          "caseFold": false
        }
      ],
      "validator": "VaultServiceToken",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 0,
      "maxLookahead": 170,
      "provenance": {
        "source": "https://github.com/hashicorp/vault/blob/main/vault/token_store.go; https://github.com/gitleaks/gitleaks/blob/master/config/gitleaks.toml",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "export VAULT_TOKEN=hvs.ld4Ki-Hfk1htnZr3dfRKIbAPeW6N9c54fl9W2Fmz9c238OBYbOQjsfVeZdWc45s-4D3q2KyKXcJmNUJ4o7L_-RfvuZfhMuTfHRLu",
          "{\"auth\":{\"client_token\":\"hvs.nssrJa6yw4IUk6yEu4d-yIVGKpG3tDejyK9pTLdUSl_Vq6wdBNoGaf-TyrN1Djzdd-Jsmdo41LD-iQdD5v\"}}"
        ],
        "nomatch": [
          "hvs.tooshort",
          "hvs.XXXXXXXXXXXXXXXXXXXXXXXX"
        ]
      }
    },
    {
      "id": "vault-batch-token",
      "name": "HashiCorp Vault batch token",
      "triggers": [
        {
          "literal": "hvb.",
          "caseFold": false
        }
      ],
      "validator": "VaultBatchToken",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 0,
      "maxLookahead": 330,
      "provenance": {
        "source": "https://github.com/hashicorp/vault/blob/main/vault/token_store.go; https://github.com/gitleaks/gitleaks/blob/master/config/gitleaks.toml",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "export VAULT_TOKEN=hvb.KpG3tDejyK9pTLdUSl_Vq6wdBNoGaf-TyrN1Djzdd-Jsmdo41LD-iQdD5veIiTfY02uKTx4ioKi7IOLaIhbbUuYTN_ZEvWVYPknt1z18SGmNFPdLIcySo_hlQZbpcUeroBfki2yLt1qc6PCYFQP79YcXeDLgtjFOrVEiHuAPOAJFIuaiduxuRQ4I_QWODAAReCfDLkkR"
        ],
        "nomatch": [
          "hvb.tooshort"
        ]
      }
    },
    {
      "id": "terraform-cloud-api-token",
      "name": "HCP Terraform / Terraform Enterprise API token",
      "triggers": [
        {
          "literal": ".atlasv1.",
          "caseFold": false
        }
      ],
      "validator": "TerraformCloudAPIToken",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 16,
      "maxLookahead": 90,
      "provenance": {
        "source": "https://developer.hashicorp.com/terraform/cloud-docs/api-docs/user-tokens; https://developer.hashicorp.com/terraform/cloud-docs/api-docs/team-tokens; https://developer.hashicorp.com/terraform/cloud-docs/api-docs/organization-tokens",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "export TF_TOKEN_app_terraform_io=fbWTHJCs5eFRVZ.atlasv1.Hfk1htnZr3dfRKIbAPeW6N9c54fl9W2Fmz9c238OBYbOQjsfVeZdWc45s-4D3q2K",
          "{\"credentials\":{\"app.terraform.io\":{\"token\":\"msXQyb5HRPrMMQ.atlasv1.mNUJ4o7L_-RfvuZfhMuTfHRLuKpG3tDejyK9pTLdUSl_Vq6wdBNoGaf-TyrN1Djzdd-Jsm\"}}}"
