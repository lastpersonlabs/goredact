          "7Tbh35JCAso6J7.atlasv1.-iQdD5veIiTfY02uKTx4ioKi7IOLaIhbbUuYTN_ZEvWVYPknt1z18SGmNFP",
          "short.atlasv1.Hfk1htnZr3dfRKIbAPeW6N9c54fl9W2Fmz9c238OBYbOQjsfVeZdWc45s-4D3q2K"
        ]
      }
    },
    {
      "id": "aws-bedrock-long-lived-api-key",
      "name": "AWS Bedrock long-lived API key",
      "triggers": [
        {
          "literal": "ABSKQmVkcm9ja0FQSUtleS",
          "caseFold": false
        }
      ],
      "validator": "AWSBedrockLongLivedAPIKey",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 0,
      "maxLookahead": 280,
      "provenance": {
        "source": "https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html; https://github.com/awslabs/git-secrets",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "AWS_BEARER_TOKEN_BEDROCK=ABSKQmVkcm9ja0FQSUtleS1JsxxGJaQ4E7VYU861k0Q2JFWurEFcHTB3pWIQsxSkp17IPEFuZJ3LArOxD1u7fB08el5jzT3r5+5VZtUxmlfUSk2VaOi1tSZz3ARZsPFTH+BW",
          "Authorization: Bearer ABSKQmVkcm9ja0FQSUtleSlRvuuRnt7Y3o6/Q75w8HPaglhAJxUx5Ayt9W+dXYUTiNW8XCYbXU1vvUoIQYUm1lHGdHQyywBI6VetDUAP8gleQJlIpJZ4J97nrpRrXps+PhB2tMROOlsn5She1qBi4hWthgd5CeARuVfb12mwEQ54=="
        ],
        "nomatch": [
          "ABSKQmVkcm9ja0FQSUtleS0ITXcfEizf9p/ipTSw4dhRz68i9+ZVFYXE+s3GQoCTnVmfRUtn"
        ]
      }
    },
    {
      "id": "aws-bedrock-short-lived-api-key",
      "name": "AWS Bedrock short-lived API key",
      "triggers": [
        {
          "literal": "bedrock-api-key-YmVkcm9jay5hbWF6b25hd3MuY29t",
          "caseFold": false
        }
      ],
      "validator": "AWSBedrockShortLivedAPIKey",
      "minProfile": "fast",
      "confidence": "high",
      "maxLookbehind": 0,
      "maxLookahead": 4200,
      "provenance": {
        "source": "https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html; https://github.com/aws/aws-bedrock-token-generator-js; https://github.com/awslabs/git-secrets",
        "license": "original"
      },
      "fixtures": {
        "match": [
          "AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-",
          "Authorization: Bearer bedrock-api-key-YmVkcm9jay5hbWF6b25hd3MuY29tKSpybDxEDr1zJkNrNg0CfS39lWZIUzBRDmsQTTGcCDO4DudsHfptBHDXTCjN=="
        ],
        "nomatch": [
          "bedrock-api-key-YmVkcm9jay5hbWF6b25hd3MuY29t35bxEdKAy+"
        ]
      }
    }
  ]
}
